# Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for cookie-consent persistence, Terms/Privacy
# acceptance audit rows, and the Stripe webhook + credit ledger writes.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL. lib/site.ts reads this; nothing else should.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SEO and analytics ───────────────────────────────────────────────────
# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Leave blank to
# disable analytics in this environment. lib/site.ts -> googleAnalyticsId()
# is the only reader. Consent Mode v2 defaults storage to denied; the
# cookie banner flips analytics_storage to granted on opt-in.
NEXT_PUBLIC_GA_ID=

# Search engine ownership tokens. Set after verifying the property in
# Search Console / Bing Webmaster Tools. Emitted as <meta> tags by the
# root layout; safe to leave blank locally.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Stripe billing ──────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys (use test-mode keys
# locally and in Vercel preview environments).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Get it from `stripe listen` in development, or
# from the dashboard webhook endpoint config in production.
STRIPE_WEBHOOK_SECRET=

# Recurring Price ids per plan, copied from the Stripe dashboard after
# creating Products. Leave blank to disable a tier.
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# JSON map of one-off top-up Price id -> credits granted on payment, e.g.
#   {"price_aaa":500,"price_bbb":1500,"price_ccc":3500}
# Each Price should be a one-time charge under a "Credit pack" Product.
STRIPE_TOPUP_PACKS=
